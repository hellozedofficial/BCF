{
  "name": "carrom-federation-root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install && npm --prefix admin install",
    "start": "node app.js",
    "build:all": "npm --prefix client run build && npm --prefix admin run build",
    "build:cpanel": "npm run build:all && node scripts/prepare-cpanel.js",
    "server": "node app.js",
    "admin": "node app.js",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "admin:dev": "npm --prefix admin run dev",
    "client": "npm --prefix client run dev",
    "db:init": "npm --prefix server run db:init",
    "dev": "concurrently -n \"SERVER,CLIENT,ADMIN\" -c \"blue,green,magenta\" \"npm run server:dev\" \"npm run client:dev\" \"npm run admin:dev\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  }
}
