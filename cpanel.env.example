# ==============================================================================
# Bangladesh Carrom Federation (BCF) - cPanel Production Environment (.env)
# Rename this file to '.env' inside your cPanel Node.js Application directory
# ==============================================================================
PORT=5050
NODE_ENV=production

# 🗄️ MySQL Database Credentials (Created in cPanel -> MySQL Database Wizard)
DB_HOST=localhost
DB_PORT=3306
DB_USER=yourcpanel_bcfuser
DB_PASSWORD=your_db_password
DB_NAME=yourcpanel_bcf

# 🌐 Production URLs for bcf.org.bd:
CLIENT_URL=https://bcf.org.bd
ADMIN_URL=https://bcf.org.bd/admin
API_URL=https://bcf.org.bd/api
SERVER_URL=https://bcf.org.bd

# 🎨 Theme Primary Color
PRIMARY_COLOR=#84b701

# 📂 Admin Base Route
ADMIN_BASE_PATH=/admin/

# ☁️ Cloud Object Storage (CDN)
B2_ENABLED=true
B2_KEY_ID=003f1a3b7e63fc10000000002
B2_APPLICATION_KEY=K003AYDIgU36ILLrye8Pn1+u4TG5Igg
B2_REGION=eu-central-003
B2_BUCKET=bangladeshcarromcdn
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_URL=https://f003.backblazeb2.com/file/bangladeshcarromcdn

# 📧 SMTP Webmail Settings (Created in cPanel -> Email Accounts)
MAIL_HOST=mail.bcf.org.bd
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=noreply@bcf.org.bd
MAIL_PASSWORD=your_email_password
MAIL_FROM_ADDRESS=noreply@bcf.org.bd
MAIL_FROM_NAME="Bangladesh Carrom Federation"
MAIL_REPLY_TO=info@bcf.org.bd

