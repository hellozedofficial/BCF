# ==============================================================================
# Bangladesh Carrom Federation (BCF) - Environment Configuration
# ==============================================================================
PORT=5050
NODE_ENV=production

# 🗄️ MySQL Database (Configured in cPanel MySQL Database Wizard)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_mysql_password
DB_NAME=cpaneluser_bcf

# 🌐 URLs for Bangladesh Carrom Federation (bcf.org.bd):
# Option A (Unified single domain - recommended for straightforward cPanel deployment):
CLIENT_URL=https://bcf.org.bd
ADMIN_URL=https://bcf.org.bd/admin
API_URL=https://bcf.org.bd/api
SERVER_URL=https://bcf.org.bd

# Option B (Separate subdomains):
# CLIENT_URL=https://bcf.org.bd
# ADMIN_URL=https://admin.bcf.org.bd
# API_URL=https://api.bcf.org.bd/api
# SERVER_URL=https://api.bcf.org.bd

# 🎨 Admin Panel Theme Primary Color (BCF Official Green)
PRIMARY_COLOR=#84b701

# 📂 Admin Base Path:
# Set to '/admin/' if admin is inside public_html/admin/ (bcf.org.bd/admin).
# Set to '/' if admin is on its own subdomain (admin.bcf.org.bd).
ADMIN_BASE_PATH=/admin/

# 📧 Email SMTP Configuration (cPanel Webmail or custom SMTP)
MAIL_HOST=mail.bcf.org.bd
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=noreply@bcf.org.bd
MAIL_PASSWORD=your_cpanel_email_password
MAIL_FROM_ADDRESS=noreply@bcf.org.bd
MAIL_FROM_NAME="Bangladesh Carrom Federation"
MAIL_REPLY_TO=info@bcf.org.bd
